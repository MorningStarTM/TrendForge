# Build-context excludes for the backend image (context is the repo root).
.git
.gitignore
.venv
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Node / Next.js (frontend has its own image + .dockerignore)
frontend/node_modules
frontend/.next
node_modules

# Secrets and local files — never bake into an image
.env
**/.env
docs
engineering
*.log
**/*.log
scratchpad
